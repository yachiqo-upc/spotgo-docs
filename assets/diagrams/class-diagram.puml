@startuml spotgo-domain-class-diagram
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing false
skinparam packageStyle rectangle

title SpotGo Domain Class Diagram (Domain-Driven Design)

' =====================================================================
' BOUNDED CONTEXT 1: PROFILES & VEHICLES MANAGEMENT
' =====================================================================
package "Profiles & Vehicles Management Context" #E1F5FE {
    class Profile <<AggregateRoot>> {
        - UUID profileId
        - UUID accountId
        - String firstName
        - String lastName
        - String phone
        - Timestamp createdAt
        - Timestamp updatedAt
        + update(firstName: String, lastName: String, phone: String): Void
    }

    class Vehicle <<Entity>> {
        - UUID vehicleId
        - UUID profileId
        - String? plate
        - String make
        - String model
        - String color
        - VehicleStatus status
        + update(plate, make, model, color, status): Void
        + normalizePlate(value: String): String
    }

    class DriverClassification <<Entity>> {
        - UUID classificationId
        - UUID profileId
        - UUID tenantId
        - DriverProfileType profileType
        - UUID assignedBy
        - Timestamp createdAt
        - Timestamp updatedAt
        + assign(type: DriverProfileType, administrator: Profile): Void
    }

    class ProfilesManagementService <<ApplicationService>> {
        + registerProfile(): Profile
        + updateProfile(): Profile
        + registerVehicle(): Vehicle
        + assignClassification(): DriverClassification
    }

    enum DriverProfileType <<Enum>> {
        TAXI
        EMPLOYEE
        PRIVATE
    }

    enum VehicleStatus <<Enum>> {
        ACTIVE
        INACTIVE
    }

    interface ProfileRepository <<Repository>> {
        + findByAccountId(accountId: UUID): Optional<Profile>
        + existsByAccountId(accountId: UUID): Boolean
        + save(profile: Profile): Profile
    }

    interface VehicleRepository <<Repository>> {
        + findAllByProfileId(profileId: UUID): List<Vehicle>
        + save(vehicle: Vehicle): Vehicle
    }

    interface DriverClassificationRepository <<Repository>> {
        + findByProfileIdAndTenantId(profileId: UUID, tenantId: UUID): Optional<DriverClassification>
        + findAllByTenantId(tenantId: UUID): List<DriverClassification>
        + save(classification: DriverClassification): DriverClassification
    }

    Profile "1" <-- "0..*" Vehicle : owner FK >
    Profile "1" <-- "0..*" DriverClassification : driver FK >
    Profile "1" <-- "0..*" DriverClassification : assignedBy FK >
    Vehicle "1" --> "1" VehicleStatus
    DriverClassification "1" --> "1" DriverProfileType
    ProfilesManagementService ..> ProfileRepository : consulta y persiste >
    ProfilesManagementService ..> VehicleRepository : consulta y persiste >
    ProfilesManagementService ..> DriverClassificationRepository : consulta y persiste >
}

' =====================================================================
' BOUNDED CONTEXT 2: IDENTITY & ACCESS MANAGEMENT (IAM)
' =====================================================================
package "Identity & Access Management Context" #F3E5F5 {
    class Account <<AggregateRoot>> {
        - UUID accountId
        - String email
        - AccountStatus status
        - Timestamp createdAt
        - Timestamp updatedAt
        + activate(): Void
        + suspend(): Void
        + lock(): Void
        + canAuthenticate(): Boolean
    }

    class Credential <<Entity>> {
        - UUID credentialId
        - UUID accountId
        - AuthenticationMethod authenticationMethod
        - String secretHash
        - String externalSubject
        - Timestamp lastUsedAt
        - CredentialStatus status
        + verify(secret: String): Boolean
        + rotate(): Void
        + revoke(): Void
    }

    class Session <<Entity>> {
        - UUID sessionId
        - UUID accountId
        - String refreshTokenHash
        - Timestamp createdAt
        - Timestamp expiresAt
        - Timestamp lastActivityAt
        - IdentitySessionStatus status
        + isExpired(): Boolean
        + refresh(): Void
        + revoke(): Void
    }

    class RoleAssignment <<Entity>> {
        - UUID assignmentId
        - UUID accountId
        - RoleType role
        - UUID? tenantId [required for PARKING_ADMIN]
        - Timestamp validFrom
        - Timestamp validTo
        - Boolean isActive
        + isValidAt(at: Timestamp): Boolean
        + revoke(): Void
    }

    class AuditEntry <<Entity>> {
        - UUID auditId
        - UUID accountId
        - String action
        - String result
        - String source
        - Timestamp occurredAt
        - String correlationId
        + record(): Void
    }

    class Permission <<ValueObject>> {
        - String resource
        - String action
        - String scope
        + allows(resource: String, action: String): Boolean
    }

    enum RoleType <<Enum>> {
        DRIVER
        PARKING_ADMIN
        SUPER_ADMIN
    }

    enum AccountStatus <<Enum>> {
        PENDING
        ACTIVE
        SUSPENDED
        LOCKED
        INACTIVE
    }

    enum AuthenticationMethod <<Enum>> {
        PASSWORD
        GOOGLE
    }

    enum CredentialStatus <<Enum>> {
        ACTIVE
        REVOKED
    }

    enum IdentitySessionStatus <<Enum>> {
        ACTIVE
        EXPIRED
        REVOKED
    }

    class AccountFactory <<Factory>> {
        + createAccount(): Account
    }

    class SessionFactory <<Factory>> {
        + createSession(): Session
    }

    class AuthenticationService <<ApplicationService>> {
        + authenticate(): Account
    }

    class AccountAdministrationService <<ApplicationService>> {
        + assign(): RoleAssignment
        + status(): Account
        + provisionParkingAdmin(): ProvisionedParkingAdmin
    }

    class AuthorizationService <<DomainService>> {
        + authorize(): Boolean
        + hasPermission(): Boolean
    }

    class SessionPolicy <<DomainService>> {
        - Integer accessTokenMinutes = 15
        - Integer refreshTokenDays = 7
        - Integer webIdleMinutes = 30
        - Integer webMaxHours = 8
        + calculateExpiry(): Timestamp
        + isRefreshAllowed(): Boolean
        + revokeOnSecurityEvent(): Void
    }

    interface AccountRepository <<Repository>> {
        + findById(id: UUID): Account
        + findByEmail(email: String): Account
        + findByExternalSubject(authenticationMethod: AuthenticationMethod, externalSubject: String): Account
        + save(account: Account): Void
    }

    interface SessionRepository <<Repository>> {
        + findById(id: UUID): Session
        + findActiveByAccount(accountId: UUID): List<Session>
        + save(session: Session): Void
        + revoke(sessionId: UUID): Void
    }

    interface AuditEntryRepository <<Repository>> {
        + save(entry: AuditEntry): Void
        + findByAccount(accountId: UUID): List<AuditEntry>
        + findByCorrelationId(correlationId: String): List<AuditEntry>
    }

    Account "1" *-- "1..*" Credential : posee >
    Account "1" *-- "0..*" Session : inicia >
    Account "1" *-- "0..1" RoleAssignment : recibe >
    Account "1" *-- "0..*" AuditEntry : genera >
    RoleAssignment "1" --> "1" RoleType : rol >
    Account "1" --> "1" AccountStatus
    Credential "1" --> "1" AuthenticationMethod
    Session "1" --> "1" IdentitySessionStatus
    AuthenticationService ..> Credential : verifica >
    AuthorizationService ..> RoleAssignment : evalúa >
    AuthorizationService ..> Permission : comprueba >
    SessionPolicy ..> Session : regula >
    AccountRepository ..> Account : persiste >
    AccountAdministrationService ..> AccountRepository : consulta y persiste >
    AccountAdministrationService ..> AuthenticationService : provisiona cuenta e invitación >
    AccountAdministrationService ..> RoleAssignment : asigna rol y Tenant scope >
    AccountAdministrationService ..> ProfilesManagementService : crea perfil administrativo >
    SessionRepository ..> Session : persiste >
    AuditEntryRepository ..> AuditEntry : persiste >

    note right of Credential
        PASSWORD: secretHash requerido; externalSubject nulo.
        GOOGLE: externalSubject contiene el sub del ID token;
        secretHash nulo. IAM valida el token de Google
        y emite la sesión y los tokens de SpotGo.
    end note
}

' =====================================================================
' SHARED EVENTING & PUSH NOTIFICATIONS
' =====================================================================
package "Shared Eventing & Notifications" #FFFDE7 {
    class PushDeviceToken <<Entity>> {
        - UUID deviceTokenId
        - UUID accountId
        - String deviceToken
        - DevicePlatform platform
        - Timestamp createdAt
        - Timestamp lastSeenAt
        + register(): Void
    }

    enum DevicePlatform <<Enum>> {
        ANDROID
        IOS
        WEB
    }

    interface PushDeviceTokenRepository <<Repository>> {
        + findByToken(token: String): PushDeviceToken
        + findAllByAccount(accountId: UUID): List<PushDeviceToken>
        + save(token: PushDeviceToken): Void
    }

    class SpotgoDomainEvent <<Event>> {
        - UUID eventId
        - String type
        - String sourceContext
        - String aggregateType
        - UUID aggregateId
        - UUID? tenantId
        - List<UUID> recipientAccountIds
        - Map<String,String> data
        - Timestamp occurredAt
    }

    class SpotgoDomainEventPublisher <<ApplicationService>> {
        + publish(type: String, sourceContext: String, aggregateType: String, aggregateId: UUID, tenantId: UUID, recipients: List<UUID>, data: Map): Void
    }

    class DomainEventNotificationListener <<EventHandler>> {
        + on(event: SpotgoDomainEvent): Void
    }

    class PushNotificationService <<ApplicationService>> {
        + send(event: SpotgoDomainEvent): Void
    }

    interface PushNotificationGateway <<Port>> {
        + send(tokens: List<String>, title: String, body: String, data: Map): List<String>
    }

    class FirebaseAdminPushNotificationGateway <<Adapter>> {
        + send(tokens: List<String>, title: String, body: String, data: Map): List<String>
    }

    SpotgoDomainEventPublisher ..> SpotgoDomainEvent : crea >
    PushDeviceToken "1" --> "1" DevicePlatform
    DomainEventNotificationListener ..> SpotgoDomainEvent : consume después del commit >
    DomainEventNotificationListener ..> PushNotificationService : delega >
    PushNotificationService ..> PushDeviceTokenRepository : consulta destinatarios >
    PushNotificationService ..> PushNotificationGateway : envía >
    FirebaseAdminPushNotificationGateway ..|> PushNotificationGateway : implementa >
}

' =====================================================================
' BOUNDED CONTEXT 3: PARKING INFRASTRUCTURE
' =====================================================================
package "Parking Infrastructure Context" #E8F5E9 {
    class Tenant <<AggregateRoot>> {
        - UUID tenantId
        - UUID? tokenId
        - String name
        - String address
        - Map<String, Object> coordinates
        - Map<String, Object> contactData
        - Map<String, Object> rules
        - TenantStatus status
        - List<ParkingZone> zones
        + activate(): Void
        + suspend(): Void
        + configure(): Void
        + addZone(zone: ParkingZone): Void
        + calculateTotalCapacity(): Integer
    }

    class ParkingZone <<AggregateRoot>> {
        - UUID zoneId
        - UUID tenantId
        - String name
        - Map<String, Object> location
        - String colorCode
        - Set<DriverProfileType> allowedProfileTypes
        - ZoneStatus status
        + update(name, location, colorCode, status, allowedProfileTypes): Void
    }

    class ParkingSpot <<Entity>> {
        - UUID spotId
        - UUID zoneId
        - String spotCode
        - String spotType
        - Map<String, Object> features
        - OperationalStatus status
        + update(code, type, features, operationalStatus): Void
    }

    class Reservation <<AggregateRoot>> {
        - UUID reservationId
        - UUID tenantId
        - UUID profileId
        - UUID vehicleId
        - UUID zoneId
        - UUID spotId
        - UUID? paymentId
        - Instant startAt
        - Instant endAt
        - Decimal amount
        - ReservationStatus status
        - LockStatus lockStatus
        - Instant lockedAt
        - Instant lockExpiresAt
        + blocks(now: Instant): Boolean
        + expire(now: Instant): Void
        + attachPayment(paymentId: UUID): Void
        + confirm(paymentId: UUID, now: Instant): Void
        + reassignSpot(spot: ParkingSpot): Void
        + cancel(): Void
        + start(): Void
        + complete(overstay: Boolean): Void
        + noShow(): Void
    }

    class ReservationChange <<Entity>> {
        - UUID reservationChangeId
        - UUID reservationId
        - Instant startAt
        - Instant endAt
        - Decimal amount
        - Decimal paymentAmount
        - UUID? paymentId
        - ReservationChangeStatus status
        - Instant? refundDueAt
        + attachPayment(paymentId: UUID): Void
        + applied(): Void
        + refundResult(): Void
        + supersede(): Void
    }

    class FavoriteTenant <<Entity>> {
        - UUID favoriteId
        - UUID profileId
        - UUID tenantId
        - Timestamp createdAt
    }

    class GuestParkingSession <<AggregateRoot>> {
        - UUID guestSessionId
        - UUID tenantId
        - UUID zoneId
        - UUID spotId
        - String manualPlate
        - Timestamp entryAt
        - Timestamp exitAt
        - Decimal calculatedAmount
        - PhysicalPaymentMethod physicalPaymentMethod
        - Boolean physicalPaymentConfirmed
        - GuestSessionStatus status
        + confirmPhysicalPayment(): Void
        + close(): Void
    }

    class AvailabilityProjection <<ValueObject>> {
        - UUID spotId
        - ReservationStatus reservationState
        - String occupancyStateRef
        - AvailabilityStatus availability
        - Timestamp observedAt
        + isBookable(): Boolean
        + isReliable(): Boolean
    }

    class ParkingSession <<AggregateRoot>> {
        - UUID sessionId
        - UUID reservationId
        - UUID profileId
        - UUID vehicleId
        - UUID spotId
        - Timestamp entryAt
        - Timestamp exitAt
        - ParkingSessionStatus status
        + start(): Void
        + close(): Void
        + close(): Void
    }

    class FloorPlan <<Entity>> {
        - UUID floorPlanId
        - UUID zoneId
        - Integer version
        - FloorPlanStatus status
        + publishVersion(): Void
        + archiveVersion(): Void
    }

    class DigitalParkingMap <<Entity>> {
        - UUID mapId
        - UUID floorPlanId
        - Integer version
        - String elements
        - MapStatus status
        + generate(): Void
        + publish(): Void
        + updateAvailability(): Void
    }

    enum ReservationStatus <<Enum>> {
        PENDING_PAYMENT
        RESERVED
        ACTIVE
        COMPLETED
        CANCELLED
        NO_SHOW
        OVERSTAYED
        PAYMENT_REJECTED
    }

    enum ReservationChangeStatus <<Enum>> {
        PENDING_PAYMENT
        REFUND_SCHEDULED
        REFUND_REQUESTED
        APPLIED
        REFUNDED
        REFUND_FAILED
        SUPERSEDED
    }

    enum ParkingSessionStatus <<Enum>> {
        ACTIVE
        COMPLETED
        PENDING_CLOSURE
    }

    enum GuestSessionStatus <<Enum>> {
        OPEN
        CLOSED
        PENDING_REVIEW
    }

    enum OperationalStatus <<Enum>> {
        ACTIVE
        INACTIVE
        MAINTENANCE
    }

    enum ZoneStatus <<Enum>> {
        ACTIVE
        INACTIVE
    }

    enum AvailabilityStatus <<Enum>> {
        AVAILABLE
        RESERVED
        TEMPORARILY_LOCKED
        OCCUPIED
        UNAVAILABLE
    }

    enum LockStatus <<Enum>> {
        ACTIVE
        EXPIRED
        RELEASED
        CONFIRMED
    }

    enum TenantStatus <<Enum>> {
        ACTIVE
        SUSPENDED
    }

    enum FloorPlanStatus <<Enum>> {
        DRAFT
        PUBLISHED
        ARCHIVED
    }

    enum MapStatus <<Enum>> {
        DRAFT
        PUBLISHED
        ARCHIVED
    }

    enum PhysicalPaymentMethod <<Enum>> {
        CASH
        POS
    }

    class ReservationFactory <<Factory>> {
        + createReservation(): Reservation
    }

    class GuestSessionFactory <<Factory>> {
        + createGuestSession(): GuestParkingSession
    }

    class SpotAllocationService <<DomainService>> {
        + findCompatibleSpot(): ParkingSpot
        + allocate(): Void
    }

    class AvailabilityService <<DomainService>> {
        + queryAvailability(): AvailabilityProjection
        + isAvailable(): Boolean
    }

    class ParkingReservationReassignmentService <<ApplicationService>> {
        + reassignFor(event: SpotgoDomainEvent): Optional<Reservation>
        + findCompatibleAvailableSpot(): ParkingSpot
    }

    class OverstayPolicy <<DomainService>> {
        - Integer toleranceMinutes = 5
        + evaluate(): Boolean
        + isOverstayed(): Boolean
    }

    class NavigationService <<DomainService>> {
        + buildRouteRequest(): String
    }

    class TenantOnboardingService <<ApplicationService>> {
        + onboard(): Result
    }

    interface TenantRepository <<Repository>> {
        + findById(id: UUID): Tenant
        + save(tenant: Tenant): Void
        + updateStatus(tenant: Tenant): Void
    }

    interface ParkingLayoutRepository <<Repository>> {
        + findZone(zoneId: UUID): ParkingZone
        + findSpot(spotId: UUID): ParkingSpot
        + saveZone(zone: ParkingZone): Void
        + saveSpot(spot: ParkingSpot): Void
        + saveFloorPlan(plan: FloorPlan): Void
        + publishMap(map: DigitalParkingMap): Void
    }

    interface ReservationRepository <<Repository>> {
        + findById(id: UUID): Reservation
        + overlappingSpot(spotId: UUID, start: Instant, finish: Instant): List<Reservation>
        + save(reservation: Reservation): Void
        + releaseExpiredLocks(): Void
    }

    interface ParkingSessionRepository <<Repository>> {
        + findActive(): List<ParkingSession>
        + save(session: ParkingSession): Void
        + close(sessionId: UUID): Void
    }

    Tenant "1" *-- "0..*" ParkingZone : organiza >
    Tenant "0..*" --> "0..1" PaymentToken : token_id default (FK física nullable)
    ParkingZone "1" *-- "0..*" ParkingSpot : contiene >
    Reservation "1" --> "1" ReservationStatus
    Reservation "1" --> "1" LockStatus
    Reservation "1" --> "0..1" ParkingSession : origina >
    Reservation "1" --> "0..*" ReservationChange : cambios >
    ReservationChange "1" --> "1" ReservationChangeStatus
    FavoriteTenant "0..*" --> "1" Profile : perfil Driver >
    FavoriteTenant "0..*" --> "1" Tenant : Tenant favorito >
    GuestParkingSession "1" --> "1" PhysicalPaymentMethod
    GuestParkingSession "1" --> "1" GuestSessionStatus
    ParkingSession "1" --> "1" ParkingSessionStatus
    ParkingSpot "1" --> "1" OperationalStatus
    ParkingZone "1" --> "1" ZoneStatus
    ParkingZone ..> DriverProfileType : allowed_profile_types JSONB
    AvailabilityProjection "1" --> "1" AvailabilityStatus
    FloorPlan "1" *-- "0..*" DigitalParkingMap : versiona >
    AvailabilityService ..> AvailabilityProjection : calcula >
    SpotAllocationService ..> AvailabilityService : consulta >
    ParkingReservationReassignmentService ..> Reservation : reasigna >
    ParkingReservationReassignmentService ..> ParkingSpot : busca alternativa disponible >
    OverstayPolicy ..> ParkingSession : evalúa >
    NavigationService ..> ParkingZone : prepara destino >
    TenantOnboardingService ..> Tenant : crea >
    TenantOnboardingService ..> AccountAdministrationService : provisiona administrador dentro de la transacción >
}

' =====================================================================
' BOUNDED CONTEXT 4: PAYMENTS & BILLING
' =====================================================================
package "Payments & Billing Context" #FFF3E0 {
    class DigitalPayment <<AggregateRoot>> {
        - UUID paymentId
        - UUID? tokenId
        - UUID profileId
        - PaymentOperationType operationType
        - BigDecimal amount
        - String currency
        - PaymentStatus status
        - String? providerOperationRef
        - String idempotencyKey
        - String requestHash
        - String resultReference
        - Timestamp createdAt
        - Timestamp? approvedAt
        + pending(): Void
        + result(): Void
        + seen(): Void
        + replaceToken(): Void
    }

    class Subscription <<AggregateRoot>> {
        - UUID subscriptionId
        - UUID? profileId
        - UUID? tenantId
        - UUID paymentId
        - Map<String,Object> plan JSONB
        - Timestamp startAt
        - Timestamp? endAt
        - SubscriptionStatus status
        + updatePlan(): Void
        + close(): Void
        + expire(): Void
        + activeAt(): Boolean
    }

    class PaymentAttempt <<Entity>> {
        - UUID attemptId
        - UUID paymentId
        - Integer attemptNumber
        - Timestamp startedAt
        - Timestamp? finishedAt
        - PaymentAttemptStatus status
        - String? errorCode
        - Timestamp? nextAttemptAt
        + finish(): Void
    }

    class PaymentToken <<Entity>> {
        - UUID tokenId
        - UUID profileId
        - String providerTokenRef
        - String brand
        - String lastFour
        - Integer expirationMonth
        - Integer expirationYear
        - Boolean isDefault
        - PaymentTokenStatus status
        - Timestamp createdAt
        - Timestamp? revokedAt
        + revoke(): Void
        + usable(): Boolean
    }

    class AdditionalCharge <<Entity>> {
        - UUID chargeId
        - UUID reservationId
        - UUID? paymentId
        - BigDecimal amount
        - String reason
        - String evidenceRef
        - AdditionalChargeStatus status
        - Timestamp createdAt
        + attach(): Void
        + paid(): Void
    }

    class BillingDocument <<Entity>> {
        - UUID documentId
        - UUID paymentId
        - BillingDocumentType documentType
        - String documentNumber
        - String series
        - String legalName
        - Map<String,Object> taxData JSONB
        - Timestamp issuedAt
        - BillingDocumentStatus status
        + voidDocument(): Void
    }

    class OutstandingBalance <<AggregateRoot>> {
        - UUID balanceId
        - UUID profileId
        - UUID chargeId
        - BigDecimal amount
        - Timestamp dueAt
        - OutstandingBalanceStatus status
        - Timestamp createdAt
        - Timestamp? regularizedAt
        + regularize(): Void
    }

    class Refund <<Entity>> {
        - UUID refundId
        - UUID paymentId
        - BigDecimal amount
        - String reason
        - RefundStatus status
        - String? providerOperationRef
        - Timestamp requestedAt
        - Timestamp? completedAt
        + result(): Void
    }

    interface PaymentProvider <<Port>> {
        + inspectToken(): TokenDetails
        + charge(): PaymentResult
        + reconcile(): PaymentResult
        + refund(): RefundResult
        + reconcileRefund(): RefundResult
    }

    class SimulatedPaymentProvider <<Adapter>> {
        + inspectToken(): TokenDetails
        + charge(): PaymentResult
        + reconcile(): PaymentResult
        + refund(): RefundResult
        + reconcileRefund(): RefundResult
    }

    class BillingService <<ApplicationService>> {
        + process(): DigitalPayment
        + retry(): DigitalPayment
        + reconcile(): DigitalPayment
        + reconcileSimulatedPayment(): Void
        + reconcileSimulatedRefund(): Void
        + reservationPrice(): BigDecimal
        + billSpotAddition(): DigitalPayment
    }

    class SimulatedPaymentOutcomeListener <<EventListener>> {
        + on(event: SpotgoDomainEvent): Void
    }

    class SubscriptionPlans <<ApplicationComponent>> {
        + all(): Collection<Map>
        + get(code: String): Map
        + tenantMonthlyPrice(plan: Map, parkingSpotCount: Long): BigDecimal
        + snapshotForTenant(): Map
        + licensedSpotIds(): Set<String>
    }

    interface DigitalPaymentRepository <<Repository>> {
        + findById(id: UUID): DigitalPayment
        + findByIdempotencyKey(key: String): DigitalPayment
        + save(payment: DigitalPayment): Void
    }

    interface PaymentTokenRepository <<Repository>> {
        + findById(id: UUID): PaymentToken
        + save(token: PaymentToken): Void
    }

    interface PaymentAttemptRepository <<Repository>> {
        + findByPayment(paymentId: UUID): List<PaymentAttempt>
        + save(attempt: PaymentAttempt): Void
    }

    interface SubscriptionRepository <<Repository>> {
        + findById(id: UUID): Subscription
        + save(subscription: Subscription): Void
    }

    interface AdditionalChargeRepository <<Repository>> {
        + findByReservation(reservationId: UUID): List<AdditionalCharge>
        + save(charge: AdditionalCharge): Void
    }

    interface OutstandingBalanceRepository <<Repository>> {
        + findOpenByProfile(profileId: UUID): List<OutstandingBalance>
        + save(balance: OutstandingBalance): Void
    }

    interface BillingDocumentRepository <<Repository>> {
        + findByPayment(paymentId: UUID): BillingDocument
        + save(document: BillingDocument): Void
    }

    enum PaymentStatus <<Enum>> {
        INITIATED
        PENDING
        APPROVED
        REJECTED
        CANCELLED
        RECONCILIATION_REQUIRED
    }

    enum PaymentOperationType <<Enum>> {
        RESERVATION
        SUBSCRIPTION
        SUBSCRIPTION_ADJUSTMENT
        ADDITIONAL_CHARGE
        REFUND
    }

    enum PaymentAttemptStatus <<Enum>> {
        STARTED
        SUCCESS
        TRANSIENT_FAILURE
        DEFINITIVE_FAILURE
        UNKNOWN
    }

    enum PaymentTokenStatus <<Enum>> {
        ACTIVE
        REVOKED
    }

    enum SubscriptionStatus <<Enum>> {
        ACTIVE
        PAUSED
        EXPIRED
        PAST_DUE
        CANCELLED
    }

    enum AdditionalChargeStatus <<Enum>> {
        PENDING
        PAID
        CANCELLED
    }

    enum OutstandingBalanceStatus <<Enum>> {
        OPEN
        REGULARIZED
    }

    enum RefundStatus <<Enum>> {
        REQUESTED
        PROCESSING
        COMPLETED
        FAILED
        RECONCILIATION_REQUIRED
    }

    enum BillingDocumentStatus <<Enum>> {
        ISSUED
        VOID
    }

    enum BillingDocumentType <<Enum>> {
        ELECTRONIC_RECEIPT
        ELECTRONIC_INVOICE
    }

    DigitalPayment "0..*" --> "0..1" PaymentToken : token usado >
    DigitalPayment "1" *-- "1..*" PaymentAttempt : conserva >
    DigitalPayment "1" *-- "0..*" Refund : origina >
    DigitalPayment "1" --> "1" PaymentOperationType
    DigitalPayment "1" --> "1" PaymentStatus
    Subscription "1" ..> "1" SubscriptionPlans : consulta catálogo y guarda snapshot JSONB >
    Subscription "1" --> "1" SubscriptionStatus
    Subscription "1" --> "1" DigitalPayment : pago del periodo >
    AdditionalCharge "1" --> "1" AdditionalChargeStatus
    BillingDocument "1" --> "1" DigitalPayment : documenta >
    BillingDocument "1" --> "1" BillingDocumentStatus
    BillingDocument "1" --> "1" BillingDocumentType
    OutstandingBalance "1" --> "1" OutstandingBalanceStatus
    Refund "1" --> "1" RefundStatus
    Refund "1" --> "1" DigitalPayment : reembolsa >
    PaymentAttempt "1" --> "1" PaymentAttemptStatus
    PaymentToken "1" --> "1" PaymentTokenStatus
    PaymentProvider ..> PaymentToken : autoriza_con >
    SimulatedPaymentProvider ..|> PaymentProvider : implementa >
    BillingService ..> PaymentProvider : utiliza >
    SimulatedPaymentOutcomeListener ..> BillingService : concilia después del commit >
    SimulatedPaymentOutcomeListener ..> SpotgoDomainEvent : consume eventos locales >
    BillingService ..> SubscriptionPlans : calcula planes y prorrateo >
    BillingService ..> BillingDocument : registra_o_anula >
}

' =====================================================================
' BOUNDED CONTEXT 5: OCCUPANCY & MONITORING
' =====================================================================
package "Occupancy & Monitoring Context" #FFFDE7 {
    class OccupancySensor <<Entity>> {
        - UUID sensorId
        - UUID tenantId
        - UUID zoneId
        - UUID spotId
        - SensorProtocol protocol
        - SensorStatus status
        - Timestamp lastSeenAt
        - Map<String,Object> configuration JSONB
        - Timestamp installedAt
        + seen(): Void
        + deactivate(): Void
    }

    class OccupancyReading <<Entity>> {
        - UUID readingId
        - UUID sensorId
        - UUID spotId
        - OccupancyStatus occupancyStatus
        - Timestamp occurredAt
        - Timestamp receivedAt
        - BigDecimal quality
        - String payloadHash
    }

    class SensorHealthEvent <<Entity>> {
        - UUID healthEventId
        - UUID sensorId
        - SensorHealth health
        - String reason
        - Timestamp observedAt
        - Timestamp? recoveredAt
        + recover(): Void
    }

    class OccupancyConflict <<Entity>> {
        - UUID conflictId
        - UUID tenantId
        - UUID spotId
        - UUID readingId
        - UUID? reservationId
        - ConflictType conflictType
        - Severity severity
        - Timestamp detectedAt
        - ConflictStatus status
        + acknowledge(): Void
        + resolve(): Void
    }

    class OccupancyAlert <<Entity>> {
        - UUID alertId
        - UUID tenantId
        - UUID spotId
        - UUID? healthEventId
        - UUID? conflictId
        - AlertType alertType
        - Severity severity
        - String? evidenceRef
        - Timestamp createdAt
        - Timestamp? acknowledgedAt
        - Timestamp? closedAt
        - AlertResolutionClassification? resolutionClassification
        - String? resolutionAction
        - AlertStatus status
        + acknowledge(): Void
        + close(classification: AlertResolutionClassification, action: String): Void
    }

    class CapacitySnapshot <<Entity>> {
        - UUID snapshotId
        - UUID tenantId
        - UUID? zoneId
        - Integer occupiedCount
        - Integer totalCount
        - BigDecimal percentage
        - Timestamp observedAt
    }

    class CapacityAlert <<Entity>> {
        - UUID capacityAlertId
        - UUID tenantId
        - UUID? zoneId
        - UUID snapshotId
        - BigDecimal thresholdPercentage
        - BigDecimal occupancyPercentage
        - Severity severity
        - AlertStatus status
        - Timestamp createdAt
        - Timestamp? acknowledgedAt
        - Timestamp? resolvedAt
        + acknowledge(): Void
        + resolve(): Void
    }

    class OccupancyReport <<Entity>> {
        - UUID reportId
        - UUID tenantId
        - UUID zoneId
        - Timestamp intervalStart
        - Timestamp intervalEnd
        - Map<String,Object> totals JSONB
        - Timestamp generatedAt
        - ReportStatus status
    }

    class MonitoringService <<ApplicationService>> {
        + register(): OccupancySensor
        + receive(): OccupancyReading
        + closeAlert(classification, action): OccupancyAlert
        + snapshot(): CapacitySnapshot
        + report(): OccupancyReport
    }

    class MonitoringOccupancyService <<ApplicationService>> {
        + observation(spotId: UUID): Observation
        + physicalOccupancy(spotId: UUID): String
    }

    class MonitoringPolicy <<ApplicationComponent>> {
        - Long freshnessSeconds = 300
        - BigDecimal minimumQuality = 80
        + fresh(): Boolean
        + reliable(): Boolean
    }

    enum OccupancyStatus <<Enum>> {
        AVAILABLE
        OCCUPIED
    }
    enum SensorHealth <<Enum>> {
        HEALTHY
        DEGRADED
        FAILED
        UNKNOWN
    }
    enum SensorProtocol <<Enum>> {
        MQTT
        HTTP
    }
    enum SensorStatus <<Enum>> {
        ACTIVE
        INACTIVE
    }
    enum ConflictType <<Enum>> {
        SPACE_NOT_AVAILABLE
        UNEXPECTED_OCCUPANCY
        EXPECTED_OCCUPANCY_MISSING
        OVERSTAY
    }
    enum ConflictStatus <<Enum>> {
        OPEN
        ACKNOWLEDGED
        RESOLVED
    }
    enum AlertType <<Enum>> {
        OCCUPANCY_CONFLICT
        SENSOR_FAILURE
    }
    enum AlertResolutionClassification <<Enum>> {
        UNAUTHORIZED_OCCUPANCY
        RESERVATION_REASSIGNED
        SENSOR_RECOVERED
        FALSE_POSITIVE
        OTHER
    }
    enum AlertStatus <<Enum>> {
        OPEN
        ACKNOWLEDGED
        CLOSED
    }

    interface OccupancySensorRepository <<Repository>>
    interface OccupancyReadingRepository <<Repository>>
    interface SensorHealthEventRepository <<Repository>>
    interface OccupancyConflictRepository <<Repository>>
    interface OccupancyAlertRepository <<Repository>>
    interface CapacitySnapshotRepository <<Repository>>
    interface CapacityAlertRepository <<Repository>>
    interface OccupancyReportRepository <<Repository>>

    OccupancySensor "1" *-- "0..*" OccupancyReading : registra >
    OccupancySensor "1" *-- "0..*" SensorHealthEvent : conserva >
    OccupancyReading "1" --> "0..*" OccupancyConflict : evidencia >
    OccupancyConflict "0..*" --> "0..1" Reservation : reserva opcional >
    OccupancyAlert "0..*" --> "0..1" OccupancyConflict : origen alternativo >
    OccupancyAlert "0..*" --> "0..1" SensorHealthEvent : origen alternativo >
    CapacitySnapshot "1" <-- "0..*" CapacityAlert : justifica >
    MonitoringService ..> MonitoringPolicy : valida frescura y calidad >
    MonitoringService ..> OccupancyAlertRepository : persiste >
}

